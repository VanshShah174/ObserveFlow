# ============================================================================
# TERRAFORM VARIABLES — Copy this file to terraform.tfvars and fill in values
# cp terraform.tfvars.example terraform.tfvars
# ============================================================================

# AWS region to deploy all resources
aws_region = "us-east-1"

# Environment name (used in resource tags)
environment = "dev"

# Project name — used as prefix for all resource names
project_name = "observeflow"

# VPC CIDR block (provides 65,536 IPs)
vpc_cidr = "10.0.0.0/16"

# Kubernetes version for EKS cluster
eks_cluster_version = "1.35"

# EC2 instance type for managed node group (system pods + Karpenter)
node_instance_type = "t3.medium"

# Node group scaling configuration
node_desired_size = 2
node_min_size     = 2
node_max_size     = 3
